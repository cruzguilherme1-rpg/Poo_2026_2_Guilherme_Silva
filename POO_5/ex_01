import datetime

a = datetime.datetime(2023, 6, 1)
b = datetime.datetime(2023, 6, 1, 9, 30, 15)
print(a)
print(b)

c = datetime.datetime.now()
print(c)

f = datetime.datetime.strptime("04/01/2008 00:30", "%d/%m/%Y %H:%M")
print(f)
print(f.day)
print(f.month)
print(f.year)
print(f.hour)
print(f.minute)

print(f.date())
print(f.strftime("%d/%m/%Y/ %H:%M"))

t1 = datetime.timedelta(days=1, hours=10)
print(t1)
print(f + t1)